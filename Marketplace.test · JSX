/* ════════════════════════════════════════════════════════════════════
   7. NFTPreview
   ════════════════════════════════════════════════════════════════════ */
describe("<NFTPreview />", () => {
  const contract = {};

  beforeEach(() => { vi.clearAllMocks(); });

  it("renders nothing when tokenId is empty", () => {
    const { container } = renderComp(<NFTPreview nftContract={contract} tokenId="" />);
    expect(container.firstChild).toBeNull();
  });

  it("shows loading spinner then metadata", async () => {
    readContract.mockResolvedValueOnce("https://example.com/meta/1");
    global.fetch = vi.fn().mockResolvedValueOnce({
      ok: true,
      json: async () => ({ name: "Cool NFT", description: "A great NFT", image: "https://img.example.com/1.png" }),
    });

    renderComp(<NFTPreview nftContract={contract} tokenId="1" />);
    expect(screen.getByRole("status")).toBeInTheDocument();

    await waitFor(() => expect(screen.getByText("Cool NFT")).toBeInTheDocument());
    expect(screen.getByAltText(/cool nft nft artwork/i)).toBeInTheDocument();
  });

  it("shows friendly error when readContract fails", async () => {
    readContract.mockRejectedValueOnce(new Error("fetch failed"));
    renderComp(<NFTPreview nftContract={contract} tokenId="2" />);
    await waitFor(() => expect(screen.getByText(/network error/i)).toBeInTheDocument());
  });

  it("resolves IPFS URIs correctly", async () => {
    readContract.mockResolvedValueOnce("ipfs://QmABC/meta.json");
    global.fetch = vi.fn().mockImplementation(url => {
      expect(url).toContain("https://ipfs.io/ipfs/QmABC");
      return Promise.resolve({ ok: true, json: async () => ({ name: "IPFS NFT", image: null }) });
    });
    renderComp(<NFTPreview nftContract={contract} tokenId="3" />);
    await waitFor(() => expect(screen.getByText("IPFS NFT")).toBeInTheDocument());
  });

  it("parses base64 data URI metadata", async () => {
    const meta = { name: "Data NFT", description: "inline", image: null };
    const b64  = btoa(JSON.stringify(meta));
    readContract.mockResolvedValueOnce(`data:application/json;base64,${b64}`);
    renderComp(<NFTPreview nftContract={contract} tokenId="4" />);
    await waitFor(() => expect(screen.getByText("Data NFT")).toBeInTheDocument());
  });
});

/* ════════════════════════════════════════════════════════════════════
   8. MarketStats
   ════════════════════════════════════════════════════════════════════ */
describe("<MarketStats />", () => {
  const mkt = {};

  beforeEach(() => { vi.clearAllMocks(); });

  it("shows loading '…' initially then renders stats", async () => {
    readContract
      .mockResolvedValueOnce(BigInt("2000000000000000000"))  // volume 2 MON
      .mockResolvedValueOnce(BigInt("500000000000000000"))   // floor 0.5 MON
      .mockResolvedValueOnce(BigInt(12))                     // 12 listed
      .mockResolvedValueOnce(BigInt("300000000000000000"));  // vault 0.3 MON

    renderComp(<MarketStats mkt={mkt} onVaultPool={vi.fn()} isMobile={false} />);
    expect(screen.getAllByText("…").length).toBeGreaterThan(0);
    await waitFor(() => expect(screen.getByText(/2\.00 MON/)).toBeInTheDocument());
    expect(screen.getByText("12")).toBeInTheDocument();
  });

  it("shows Retry button and calls fetchStats when all reads fail", async () => {
    readContract.mockRejectedValue(new Error("network error"));
    renderComp(<MarketStats mkt={mkt} onVaultPool={vi.fn()} isMobile={false} />);
    await waitFor(() => expect(screen.getByRole("button", { name: /retry/i })).toBeInTheDocument());

    readContract.mockResolvedValue(null);
    await userEvent.click(screen.getByRole("button", { name: /retry/i }));
    // After retry stats show — values; all null resolves to "—"
    await waitFor(() => expect(screen.getAllByText("—").length).toBeGreaterThan(0));
  });

  it("vault pool button calls onVaultPool", async () => {
    readContract.mockResolvedValue(null);
    const onVaultPool = vi.fn();
    renderComp(<MarketStats mkt={mkt} onVaultPool={onVaultPool} isMobile={false} />);
    await waitFor(() => screen.getByRole("button", { name: /vault pool/i }));
    await userEvent.click(screen.getByRole("button", { name: /vault pool/i }));
    expect(onVaultPool).toHaveBeenCalledOnce();
  });

  it("has aria-label on the section", () => {
    readContract.mockResolvedValue(null);
    renderComp(<MarketStats mkt={mkt} onVaultPool={vi.fn()} isMobile={false} />);
    expect(screen.getByRole("region", { name: /market statistics/i })).toBeInTheDocument();
  });
});

/* ════════════════════════════════════════════════════════════════════
   9. VaultPoolModal
   ════════════════════════════════════════════════════════════════════ */
describe("<VaultPoolModal />", () => {
  const mkt = {};

  beforeEach(() => { vi.clearAllMocks(); });

  it("shows vault balance after fetch", async () => {
    readContract.mockResolvedValueOnce(BigInt("1500000000000000000")); // 1.5 MON
    renderComp(<VaultPoolModal onClose={vi.fn()} mkt={mkt} />);
    await waitFor(() => expect(screen.getByText(/1\.5/)).toBeInTheDocument());
  });

  it("shows retry button on fetch failure", async () => {
    readContract.mockRejectedValueOnce(new Error("fail"));
    renderComp(<VaultPoolModal onClose={vi.fn()} mkt={mkt} />);
    await waitFor(() => expect(screen.getByRole("button", { name: /retry/i })).toBeInTheDocument());
  });

  it("calls onClose when backdrop is clicked", async () => {
    readContract.mockResolvedValueOnce(BigInt(0));
    const onClose = vi.fn();
    const { container } = renderComp(<VaultPoolModal onClose={onClose} mkt={mkt} />);
    await userEvent.click(container.firstChild); // backdrop
    expect(onClose).toHaveBeenCalled();
  });

  it("calls onClose when Escape key is pressed", async () => {
    readContract.mockResolvedValueOnce(BigInt(0));
    const onClose = vi.fn();
    renderComp(<VaultPoolModal onClose={onClose} mkt={mkt} />);
    await act(async () => {
      window.dispatchEvent(new KeyboardEvent("keydown", { key: "Escape", bubbles: true }));
    });
    // onClose called via the dialog's onKeyDown
    await userEvent.keyboard("{Escape}");
    expect(onClose).toHaveBeenCalled();
  });

  it("has role=dialog and aria-modal", () => {
    readContract.mockResolvedValueOnce(BigInt(0));
    renderComp(<VaultPoolModal onClose={vi.fn()} mkt={mkt} />);
    const dialog = screen.getByRole("dialog");
    expect(dialog).toHaveAttribute("aria-modal", "true");
  });
});

