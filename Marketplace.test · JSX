/* ════════════════════════════════════════════════════════════════════
   1. friendlyError
   ════════════════════════════════════════════════════════════════════ */
describe("friendlyError()", () => {
  it("maps 'user rejected' to wallet-cancel message", () => {
    const result = friendlyError(new Error("MetaMask: user rejected the transaction"));
    expect(result).toBe("Transaction cancelled by wallet.");
  });

  it("maps 'insufficient funds' correctly", () => {
    expect(friendlyError(new Error("insufficient funds for gas"))).toBe(
      "Insufficient MON balance for this transaction."
    );
  });

  it("maps 'execution reverted' correctly", () => {
    expect(friendlyError(new Error("execution reverted: ERC721: not owner"))).toBe(
      "Contract call reverted — check token ID and ownership."
    );
  });

  it("truncates unknown messages longer than 120 chars", () => {
    const long = "a".repeat(150);
    const result = friendlyError(new Error(long));
    expect(result).toHaveLength(120);
    expect(result.endsWith("…")).toBe(true);
  });

  it("passes through short unknown messages verbatim", () => {
    expect(friendlyError(new Error("weird error"))).toBe("weird error");
  });

  it("handles non-Error objects gracefully", () => {
    expect(() => friendlyError("string error")).not.toThrow();
    expect(friendlyError("string error")).toBe("string error");
  });
});

